{
  "manifest_version": 3,
  "name": "Content Stopper",
  "version": "1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:3001/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["animation/canvas.js"],
      "css": ["animation/style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "resources": [
        "animation/images/beek.png",
        "animation/images/half.png",
        "animation/images/cop-ready.png",
        "animation/images/cop2.png",
        "animation/images/pulling2.png",
        "animation/images/tired2.png"
      ]
    }
  ]
}
