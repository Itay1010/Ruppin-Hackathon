{
  "manifest_version": 3,
  "name": "Content Stopper",
  "version": "1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
    "host_permissions": [
        "http://localhost:3001/*"
    ]
}
